# Public Google OAuth client ID used by the browser
VITE_GOOGLE_CLIENT_ID=

# Backend origin. The frontend appends /api automatically.
# VITE_API_BASE_URL=https://autumn-music-backend.onrender.com

VITE_API_BASE_URL=https://localhost:3000/

# Enable after the deployed API includes /recommendations/profile and /recommendations/events.
VITE_RECOMMENDATION_EVENTS_ENABLED=false
